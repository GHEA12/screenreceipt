# ScreenReceipt configuration (copy to .env or export in your shell).
# Defaults run fully offline: mock judge + echo provider smoke turn.

# mock = deterministic offline rule judge (no credentials needed)
# live = model judge through OpenMinion; the run fails loudly if the model
#        does not return the typed verdict
SCREENRECEIPT_MODE=mock

# Label recorded on the receipt; must match the provider your OpenMinion
# profile (.openminion/agents.json) is configured for.
SCREENRECEIPT_PROVIDER=echo
SCREENRECEIPT_MODEL=echo

# OpenMinion working directory holding .openminion/agents.json
OPENMINION_CONFIG_DIR=.
# Profile name inside agents.json (config init creates "openminion")
OPENMINION_AGENT_ID=openminion

# Set to 0 to skip the OpenMinion echo smoke turn in mock mode
SCREENRECEIPT_SMOKE=1

# Provider keys (only for live mode; never commit real values):
# CORTENSOR_API_KEY=<redacted>
# OPENROUTER_API_KEY=<redacted>
# OPENAI_API_KEY=<redacted>
# ANTHROPIC_API_KEY=<redacted>
